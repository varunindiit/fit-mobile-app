{
  "expo": {
    "name": "Fittelo",
    "slug": "fittelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fittelo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dev.fittelo",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Fittelo uses your Apple Music library to play music during your workouts.",
        "NSPhotoLibraryUsageDescription": "Fittelo needs access to your photos so you can add progress and profile pictures."
      }
    },
    "android": {
      "package": "com.dev.fittelo",
      "adaptiveIcon": {
        "backgroundColor": "#56D661",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#56D661",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
